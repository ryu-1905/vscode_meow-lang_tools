import 'math/advanced' as my_math;
import 'core/lexer' as lex;

// Sample Struct
type Cat {
    string name,
    int age,
    boolean is_cute
}

interface HasContent {
    string content
}

/* 
 * Variables and constants declaration
 */
var a = 10;
const PI = 3.14;
var arr = int[1, 2, 3];
var is_active = true;

// Function declaration
function int add_nums(int a, int b) {
    return add(a, b);
}

function int sum_all(int... numbers) {
    var total = 0;
    for n in numbers {
        total = add(total, n);
    }
    return total;
}

// Conditions & console module
if (greater_than(a, 5)) {
    println('Value is greater than 5');
} else {
    println('Value is less than or equal to 5');
}

// Switch-case structure
switch (a) {
    case 1, 2, 3 {
        println('1-3');
    }
    default {
        println('default');
    }
}
