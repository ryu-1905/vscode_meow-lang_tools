import 'math/advanced' as my_math;
import 'core/lexer' as lex;

// Struct mẫu
type Cat {
    string name,
    int age,
    boolean is_cute
}

interface HasContent {
    string content
}

/* 
 * Khai báo biến và hằng số
 */
var a = 10;
const PI = 3.14;
var arr = int[1, 2, 3];
var is_active = true;

// Khai báo hàm
function int add_nums(int a, int b) {
    return add(a, b);
}

function int sum_all(int... numbers) {
    var total = 0;
    for n in numbers {
        total = add(total, n);
    }
    return total;
}

// Điều kiện & module console
if (greater_than(a, 5)) {
    console::println('Gia tri lon hon 5');
} else {
    console::println('Gia tri nho hon hoac bang 5');
}

// Cấu trúc switch-case
switch (a) {
    case 1, 2, 3 {
        console::println('1-3');
    }
    default {
        console::println('default');
    }
}

