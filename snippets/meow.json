{
  "Print to Console": {
    "prefix": "print",
    "body": ["console::println(${1:'Hello Meow!'});"],
    "description": "In thông điệp ra console và xuống dòng"
    "body": [
      "print(${1:'Hello Meow!'});"
    ],
    "description": "In ra terminal"
  },
  "Print without newline": {
    "prefix": "printraw",
    "body": ["console::print(${1:'Hello Meow!'});"],
    "description": "In thông điệp ra console không xuống dòng"
  },
  "Function Declaration": {
    "prefix": "fn",
    "body": [
      "function ${1|void,int,decimal,string,boolean,any|} ${2:name}(${3}) {",
      "\t${0}",
      "}"
    ],
    "description": "Khai báo hàm mới"
  },
  "Variadic Function Declaration": {
    "prefix": "fnvar",
    "body": [
      "function ${1:int} ${2:sum_all}(${3:int}... ${4:numbers}) {",
      "\t${0}",
      "}"
    ],
    "description": "Khai báo hàm có tham số biến thiên (variadic)"
  },
  "Struct Type Definition": {
    "prefix": "type",
    "body": ["type ${1:Name} {", "\t${2:string} ${3:field}", "}"],
    "body": [
      "type ${1:Name} {",
      "\t${2:string} ${3:field}",
      "}"
    ],
    "description": "Định nghĩa Struct Type"
  },
  "Interface Definition": {
    "prefix": "interface",
    "body": ["interface ${1:HasContent} {", "\t${2:string} ${3:content}", "}"],
    "body": [
      "interface ${1:HasContent} {",
      "\t${2:string} ${3:content}",
      "}"
    ],
    "description": "Định nghĩa Structural Interface"
  },
  "If Statement": {
    "prefix": "if",
    "body": ["if (${1:condition}) {", "\t${0}", "}"],
    "body": [
      "if (${1:condition}) {",
      "\t${0}",
      "}"
    ],
    "description": "Câu lệnh điều kiện if"
  },
  "If-Else Statement": {
    "prefix": "ifelse",
    "body": ["if (${1:condition}) {", "\t${2}", "} else {", "\t${0}", "}"],
    "body": [
      "if (${1:condition}) {",
      "\t${2}",
      "} else {",
      "\t${0}",
      "}"
    ],
    "description": "Câu lệnh điều kiện if-else"
  },
  "Switch Case": {
    "prefix": "switch",
    "body": [
      "switch (${1:value}) {",
      "\tcase ${2:1} {",
      "\t\t${3}",
      "\t}",
      "\tdefault {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Cấu trúc switch-case (phong cách Go)"
  },
  "For In Loop": {
    "prefix": "for",
    "body": ["for ${1:item} in ${2:collection} {", "\t${0}", "}"],
    "body": [
      "for ${1:item} in ${2:collection} {",
      "\t${0}",
      "}"
    ],
    "description": "Vòng lặp for-in qua danh sách"
  },
  "For Range Loop": {
    "prefix": "forr",
    "body": ["for ${1:i} in range(${2:0}, ${3:10}) {", "\t${0}", "}"],
    "body": [
      "for ${1:i} in range(${2:0}, ${3:10}) {",
      "\t${0}",
      "}"
    ],
    "description": "Vòng lặp for-in qua khoảng số range(start, end)"
  },
  "Variable Declaration": {
    "prefix": "var",
    "body": ["var ${1:name} = ${2:value};"],
    "body": [
      "var ${1:name} = ${2:value};"
    ],
    "description": "Khai báo biến var"
  },
  "Constant Declaration": {
    "prefix": "const",
    "body": ["const ${1:NAME} = ${2:value};"],
    "body": [
      "const ${1:NAME} = ${2:value};"
    ],
    "description": "Khai báo hằng số const"
  },
  "Import Statement": {
    "prefix": "import",
    "body": ["import '${1:module/path}' as ${2:alias};"],
    "body": [
      "import '${1:module/path}' as ${2:alias};"
    ],
    "description": "Import module với alias"
  }
}

