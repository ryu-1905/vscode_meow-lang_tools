{
  "Print to Console": {
    "prefix": "print",
    "body": ["print(${1:'Hello Meow!'});"],
    "description": "Print message to terminal without newline"
  },
  "Print with newline": {
    "prefix": "println",
    "body": ["println(${1:'Hello Meow!'});"],
    "description": "Print message to terminal with newline"
  },
  "Function Declaration": {
    "prefix": "fn",
    "body": [
      "function ${1|void,int,decimal,string,boolean,any|} ${2:name}(${3}) {",
      "\t${0}",
      "}"
    ],
    "description": "Declare a new function"
  },
  "Variadic Function Declaration": {
    "prefix": "fnvar",
    "body": [
      "function ${1:int} ${2:sum_all}(${3:int}... ${4:numbers}) {",
      "\t${0}",
      "}"
    ],
    "description": "Declare a function with variadic parameters"
  },
  "Struct Type Definition": {
    "prefix": "type",
    "body": ["type ${1:Name} {", "\t${2:string} ${3:field}", "}"],
    "description": "Define a Struct Type"
  },
  "Interface Definition": {
    "prefix": "interface",
    "body": ["interface ${1:HasContent} {", "\t${2:string} ${3:content}", "}"],
    "description": "Define a Structural Interface"
  },
  "If Statement": {
    "prefix": "if",
    "body": ["if (${1:condition}) {", "\t${0}", "}"],
    "description": "If conditional statement"
  },
  "If-Else Statement": {
    "prefix": "ifelse",
    "body": ["if (${1:condition}) {", "\t${2}", "} else {", "\t${0}", "}"],
    "description": "If-Else conditional statement"
  },
  "Switch Case": {
    "prefix": "switch",
    "body": [
      "switch (${1:value}) {",
      "\tcase ${2:1} {",
      "\t\t${3}",
      "\t}",
      "\tdefault {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Switch-case statement (Go style)"
  },
  "For In Loop": {
    "prefix": "for",
    "body": ["for ${1:item} in ${2:collection} {", "\t${0}", "}"],
    "description": "For-in loop over collection"
  },
  "For Range Loop": {
    "prefix": "forr",
    "body": ["for ${1:i} in range(${2:0}, ${3:10}) {", "\t${0}", "}"],
    "description": "For-in loop over range(start, end)"
  },
  "Variable Declaration": {
    "prefix": "var",
    "body": ["var ${1:name} = ${2:value};"],
    "description": "Declare a variable"
  },
  "Constant Declaration": {
    "prefix": "const",
    "body": ["const ${1:NAME} = ${2:value};"],
    "description": "Declare a constant"
  },
  "Import Statement": {
    "prefix": "import",
    "body": ["import '${1:module/path}' as ${2:alias};"],
    "description": "Import module with alias"
  }
}
